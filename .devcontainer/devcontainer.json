{
  "name": "EduMarket – Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  // ── Ajout de la clé Yarn avant l'installation de Docker-in-Docker ─────
  "features": {
    "./features/add-yarn-key": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": true
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true,
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  // ── Extensions VS Code pré-installées ─────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // Java / Spring
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-spring-initializr",
        "vscjava.vscode-spring-boot-dashboard",
        // Angular
        "Angular.ng-template",
        "nrwl.angular-console",
        // Docker
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        // Database
        "cweijan.vscode-postgresql-client2",
        // Quality
        "sonarsource.sonarlint-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",
        // Misc
        "yzhang.markdown-all-in-one",
        "humao.rest-client",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
        "java.compile.nullAnalysis.mode": "automatic",
        "spring-boot.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
        "editor.formatOnSave": true,
        "js/ts.preferences.importModuleSpecifier": "relative",
        "angular.enable-strict-mode-prompt": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // ── Ports forwardés automatiquement ───────────────────────────────
  "forwardPorts": [4200, 8080, 5432, 5050],
  "portsAttributes": {
    "4200": {
      "label": "Frontend Angular",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "Backend Spring Boot / Swagger UI",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "5050": {
      "label": "PGAdmin",
      "onAutoForward": "silent"
    }
  },

  // ── Script de démarrage post-création ─────────────────────────────
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // ── Utilisateur non-root (utiliser un utilisateur présent dans l'image)
  // Remplacé "codespace" par "vscode" car l'image de base n'expose pas
  // toujours l'utilisateur "codespace" et provoque l'erreur de démarrage.
  "remoteUser": "vscode"
}
